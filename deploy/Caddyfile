# HTTPS otomatis (Let's Encrypt untuk domain publik; sertifikat internal untuk localhost).
{$SITE_ADDRESS} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	# Log akses TIDAK menyertakan query string (berisi ID responden pseudonim).
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri query {
					delete
				}
			}
		}
	}
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:80
	}
}
