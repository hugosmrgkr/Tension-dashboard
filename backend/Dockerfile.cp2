FROM python:3.12-slim
WORKDIR /workspace
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MPLBACKEND=Agg MPLCONFIGDIR=/tmp/cp2-matplotlib
COPY requirements.txt requirements-dev.txt /tmp/cp2-deps/
RUN pip install --no-cache-dir -r /tmp/cp2-deps/requirements-dev.txt
CMD ["python", "-m", "pytest", "backend/tests/test_cp2.py", "backend/tests/test_api_v2.py", "-q", "-p", "no:cacheprovider"]
