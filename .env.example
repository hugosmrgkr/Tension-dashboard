# Lokal demo. Jika database volume versi lama sudah ada, gunakan password yang sama seperti volume sebelumnya.
# Ganti password SEBELUM pertama kali membuat volume PostgreSQL baru untuk penggunaan lain.
POSTGRES_PASSWORD=change-me-local-only
# Impor tidak aktif secara default. Jangan aktifkan pada deployment publik tanpa autentikasi sesungguhnya.
ENABLE_IMPORT=false
IMPORT_TOKEN=
